[Unit]
Description=Vector Host API Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/plant_virus_db/plant_virus_db_pipeline/8.plant-insect
ExecStart=/usr/local/bin/gunicorn -w 1 --threads 2 -b 127.0.0.1:5005 api_server:app --timeout 120 --graceful-timeout 30 --access-logfile /var/log/vector-host-access.log --error-logfile /var/log/vector-host-error.log --log-level info
Restart=always
RestartSec=10
StandardOutput=append:/var/log/vector-host.log
StandardError=append:/var/log/vector-host.log

[Install]
WantedBy=multi-user.target
