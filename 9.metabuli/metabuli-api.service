[Unit]
Description=Metabuli Classification API Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/plant_virus_db/plant_virus_db_pipeline/9.metabuli
ExecStart=/usr/local/bin/gunicorn -w 1 --threads 2 -b 127.0.0.1:5004 metabuli_api:app --timeout 600 --graceful-timeout 60 --access-logfile /var/log/metabuli-api-access.log --error-logfile /var/log/metabuli-api-error.log --log-level info
Restart=always
RestartSec=10
StandardOutput=append:/var/log/metabuli-api.log
StandardError=append:/var/log/metabuli-api.log

[Install]
WantedBy=multi-user.target
